# Copia este archivo como .env.development (local) y .env.production (entrega).
# Dirección del back-end. Local: http://localhost:3000 (puerto por defecto del back) — Producción: http://IP-PUBLICA-DE-LA-EC2:3000 (o el puerto que abra el Security Group).
VITE_API_URL=http://localhost:3000
# Supabase: Dashboard > Project Settings > API (URL y clave "anon / publishable").
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica-aqui
