# Copia este archivo como .env y reemplaza los valores. NUNCA subas el .env a Git.

# Puerto en el que escucha la API (el Security Group de EC2 debe abrir solo este)
PORT=3000

# Supabase: Dashboard > Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=valor-de-mentira-service-role
# Clave pública (sb_publishable_...): solo la usa la ruleta, que identifica al jugador con su token
SUPABASE_PUBLISHABLE_KEY=valor-de-mentira-publishable

# The Odds API: https://the-odds-api.com
ODDS_API_KEY=valor-de-mentira-odds

# Secreto para las rutas /api/cron/* (invéntalo, largo y aleatorio)
CRON_SECRET=valor-de-mentira-cron

# Origen(es) del front permitidos por CORS, separados por comas.
# Desarrollo: http://localhost:5173
# Entrega: la URL del bucket de S3 de tu sitio
CORS_ORIGIN=http://localhost:5173
